<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FurcaRisk AI Assistant"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Chat console -->
    <ScrollView
        android:id="@+id/scrollViewChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/dark_surface"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutChips"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <LinearLayout
            android:id="@+id/layoutChatLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Suggestion Chips -->
    <LinearLayout
        android:id="@+id/layoutChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutInputRow">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipHamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="Explain Hamp"
            app:chipBackgroundColor="@color/dark_surface"
            android:textColor="@color/white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTherapies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surgical Therapies"
            app:chipBackgroundColor="@color/dark_surface"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- Input Row -->
    <LinearLayout
        android:id="@+id/layoutInputRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@color/dark_surface"
            android:hint="Ask diagnostic questions..."
            android:textColorHint="@color/text_grey"
            android:textColor="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Send"
            app:backgroundTint="@color/primary_cyan"
            android:textColor="@color/dark_bg" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
