<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate Report"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Review diagnostic draft details prior to printing PDF report document."
            android:textColor="@color/text_grey"
            android:textSize="12sp" />

        <!-- Preview Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FURCARISK AI™ REPORT"
                    android:textColor="@color/primary_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPdfRiskBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="CRITICAL RISK (84.6%)"
                    android:textColor="@color/status_critical"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Details -->
                <TextView
                    android:id="@+id/tvPdfPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Johnathan Smith"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPdfPatientId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: FR-23091"
                    android:textColor="@color/text_grey"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPdfAgeGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42 / Male"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPdfMolarVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tooth #16"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <!-- Measurements -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:paddingTop="12dp"
                    android:background="@android:drawable/divider_horizontal_dark">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POCKET DEPTH" android:textColor="@color/text_grey" android:textSize="9sp" />
                        <TextView android:id="@+id/tvPdfPdVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.0 mm" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATTACHMENT LOSS" android:textColor="@color/text_grey" android:textSize="9sp" />
                        <TextView android:id="@+id/tvPdfCalVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3.0 mm" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnDownloadPdf"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Download PDF"
                app:backgroundTint="@color/dark_surface"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnShareReport"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Share Report"
                app:backgroundTint="@color/primary_cyan"
                android:textColor="@color/dark_bg" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
