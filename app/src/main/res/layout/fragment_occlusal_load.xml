<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvToothNumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Occlusal Load (Tooth #16)"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Simulate occlusal shear loads to predict periodontal trauma from occlusion."
            android:textColor="@color/text_grey"
            android:textSize="12sp" />

        <!-- Simulation Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Occlusal Bite Force Simulator"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Force Seekbar -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Bite Load (N)"
                    android:textColor="@color/text_grey"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <SeekBar
                        android:id="@+id/sbBiteForce"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="900" />
                    <TextView
                        android:id="@+id/tvBiteForceVal"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="600 N"
                        android:textColor="@color/primary_cyan"
                        android:textAlignment="viewEnd"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Status details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:paddingTop="12dp"
                    android:background="@android:drawable/divider_horizontal_dark">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRAUMA STATUS" android:textColor="@color/text_grey" android:textSize="9sp" />
                        <TextView android:id="@+id/tvTraumaStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Present (Overload)" android:textColor="@color/status_critical" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHEAR VECTORS" android:textColor="@color/text_grey" android:textSize="9sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hyper-lateral" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnLock"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="Lock Occlusal Parameters"
            app:backgroundTint="@color/primary_cyan"
            android:textColor="@color/dark_bg"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
