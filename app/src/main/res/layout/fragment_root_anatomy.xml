<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Molar Root Anatomy"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActiveMolarBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tooth #16 Anatomy Configuration"
            android:textColor="@color/primary_cyan"
            android:textSize="12sp" />

        <!-- Sliders Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Root Trunk Length -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Root Trunk Length (CEJ to Furcation Crotch)"
                    android:textColor="@color/text_grey"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <SeekBar
                        android:id="@+id/sbRootTrunk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="70" />
                    <TextView
                        android:id="@+id/tvRootTrunkValue"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="4.0 mm"
                        android:textColor="@color/white"
                        android:textAlignment="viewEnd"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Root Divergence Angle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Root Divergence Angle"
                    android:textColor="@color/text_grey"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <SeekBar
                        android:id="@+id/sbDivergence"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="60" />
                    <TextView
                        android:id="@+id/tvDivergenceValue"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="25°"
                        android:textColor="@color/white"
                        android:textAlignment="viewEnd"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Furcation Entrance Width -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Furcation Entrance Width"
                    android:textColor="@color/text_grey"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <SeekBar
                        android:id="@+id/sbEntrance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="30" />
                    <TextView
                        android:id="@+id/tvEntranceValue"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="1.2 mm"
                        android:textColor="@color/white"
                        android:textAlignment="viewEnd"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="Save Anatomy Parameters"
            app:backgroundTint="@color/primary_cyan"
            android:textColor="@color/dark_bg"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
