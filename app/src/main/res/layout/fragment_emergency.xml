<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency Consult"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Immediate referral routing for acute dental trauma, severe cellulitis, or root fractures."
        android:textColor="@color/text_grey"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <!-- Map placeholder card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/dark_surface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnTeleconsult"
        app:layout_constraintTop_toBottomOf="@+id/tvDesc">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Dental Trauma ER Unit"
                android:textColor="@color/primary_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Main Medical Campus\nBuilding C, Floor 1"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnTeleconsult"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:text="Connect Tele-Periodontics Video"
        app:backgroundTint="@color/primary_cyan"
        android:textColor="@color/dark_bg"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnCallER" />

    <Button
        android:id="@+id/btnCallER"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="16dp"
        android:text="Dial ER Helpline"
        app:backgroundTint="@color/status_critical"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
